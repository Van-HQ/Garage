// Copy to Config.local.xcconfig (./setup.sh does this for you). Never committed.

// Supabase project host, without "https://" (xcconfig treats "//" as a comment).
SUPABASE_HOST = your-project-ref.supabase.co

// The publishable (anon) key only. Never put the service-role key here.
SUPABASE_PUBLISHABLE_KEY = your-publishable-key

// Your Apple developer Team ID (10 letters/digits). Xcode > Settings > Accounts.
DEVELOPMENT_TEAM =

// Uncomment if Xcode says the bundle ID is already in use:
// GARAGE_BUNDLE_ID = com.vannostran.garage.van
